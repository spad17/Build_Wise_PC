<section class="component-detail">
  <p class="eyebrow"><%= Component::CATEGORY_NAMES[@component.category] %> / <%= @component.platform %></p><h1><%= @component.name %></h1><p class="muted"><%= @component.description %></p><strong class="kit-price"><%= component_price(@component) %></strong><p class="kit-help">Ориентировочная цена · не предложение магазина</p><% if manufacturer_source(@component) %><p><%= link_to "Спецификация на сайте производителя ↗", manufacturer_source(@component), target: "_blank", rel: "noopener noreferrer", class: "text-link" %></p><% end %>
  <dl class="spec-grid"><dt>Производитель</dt><dd><%= @component.manufacturer %></dd><dt>Сокет</dt><dd><%= @component.socket.presence || "Не требуется" %></dd><dt>Память</dt><dd><%= @component.memory_type.presence || "—" %><%= " / #{@component.memory_gb} ГБ" if @component.memory_gb %></dd><dt>Накопитель</dt><dd><%= @component.capacity_gb ? "#{@component.capacity_gb} ГБ" : "—" %></dd><dt><%= @component.category == "psu" ? "Мощность БП" : "Нагрузка для расчёта питания" %></dt><dd><%= @component.power_watts ? "#{@component.power_watts} Вт" : "—" %></dd><dt>Условная производительность</dt><dd><%= @component.performance %> баллов</dd><% component_specifications(@component).each do |key, value| %><dt><%= key == "cooling_watts" ? "Отвод тепла, Вт" : key %></dt><dd><%= value %></dd><% end %></dl>
  <div class="page-actions"><%= link_to "Каталог", components_path(build_id: @build&.id), class: "button button-outline" %><% if @build && @component.available? %><%= button_to "Выбрать в сборку", replace_component_build_path(@build), method: :patch, params: { component_id: @component.id }, class: "button button-primary" %><%= link_to "Моя сборка", @build, class: "text-link" %><% end %></div>
  <section class="reviews"><h2>Отзывы пользователей <span class="muted">(<%= @reviews.size %>)</span></h2>
    <% if @reviews.any? %><p class="muted">Средняя оценка: <%= number_with_precision(@reviews.map(&:rating).sum.fdiv(@reviews.size), precision: 1) %> / 5</p><% else %><p class="muted">Отзывов ещё нет. Поделитесь первым впечатлением.</p><% end %>
    <% @reviews.each do |review| %><article class="review"><div><strong><%= review.user.username %></strong><span class="review-rating" aria-label="Оценка <%= review.rating %> из 5"><%= "★" * review.rating %><%= "☆" * (5 - review.rating) %></span></div><p><%= review.body %></p><small class="muted"><%= review.created_at.strftime("%d.%m.%Y") %></small><% if current_user == review.user %><%= button_to "Удалить мой отзыв", component_review_path(@component, review), method: :delete, params: { build_id: @build&.id }, class: "button button-ghost" %><% end %></article><% end %>
    <% if logged_in? %><%= form_with model: [@component, @review], class: "editor-form panel" do |form| %><%= hidden_field_tag :build_id, @build.id if @build %><h3><%= @review.persisted? ? "Изменить свой отзыв" : "Оставить отзыв" %></h3><%= form.label :rating, "Оценка" %><%= form.select :rating, (1..5).map { |rating| ["#{rating} / 5", rating] }, selected: @review.rating || 5 %><%= form.label :body, "Ваш опыт использования" %><%= form.text_area :body, rows: 3, maxlength: 2000, required: true %><%= form.submit "Сохранить отзыв", class: "button button-primary" %><% end %><% else %><p><%= link_to "Войдите", login_path %> или <%= link_to "зарегистрируйтесь", signup_path %>, чтобы оставить отзыв.</p><% end %>
  </section>
</section>
